From: YSP benchmark instrumentation
Subject: [TEST ONLY] panfrost: add blit depth-bias benchmark override

Apply this on top of Mesa MR !43161 commit 647256dc2ae. It adds a test-only
PAN_BLIT_DEPTH_BIAS=auto|off|on|dynamic option:

- auto uses the proposed all-V9-V10 path policy, with the MR's temporary
  size/aspect gate removed;
- off suppresses the workaround; and
- on applies it to every V9-V10 internal fullscreen-blitter draw; and
- dynamic reads PAN_BLIT_DEPTH_BIAS_DYNAMIC=off|on at each internal draw, so
  the precision benchmark can alternate both treatments in one EGL context.

The default remains auto. Static modes are parsed once while the Panfrost
context creates its blitter, so their timed draw path only pays one signed-byte
branch. Dynamic mode deliberately pays an equal option lookup on both sides;
it is only for same-context measurement. The gate removal is the policy under
test; the overrides and acknowledgements are test instrumentation and are not
proposed upstream code.

diff --git a/src/gallium/drivers/panfrost/pan_blitter.c b/src/gallium/drivers/panfrost/pan_blitter.c
index 92476aabdf9..4d67864ebe7 100644
--- a/src/gallium/drivers/panfrost/pan_blitter.c
+++ b/src/gallium/drivers/panfrost/pan_blitter.c
@@ -5,6 +5,7 @@
  */
 
 #include "util/format/u_format.h"
+#include "util/u_debug.h"
 #include "pan_blitter.h"
 #include "pan_context.h"
 #include "pan_resource.h"
@@ -104,21 +105,34 @@ panfrost_blitter_draw_rectangle(struct blitter_context *blitter,
     * precision below what we need here. So we need to whack the rasterizer
     * state to make sure polygon offset is enabled.
     */
-   bool needs_workaround = false;
-   if (scr->dev.arch < 11) {
-      assert(x2 >= x1);
-      float width = x2 - x1;
-      assert(y2 >= y1);
-      float height = y2 - y1;
-
-      float min = MIN2(width, height);
-      float max = MAX2(width, height);
-      if (min <= 32.0f) {
-         float threshold = 2048.0f * exp2f(ceilf(log2f(min)) * 0.5f);
-         needs_workaround = max >= threshold;
-      }
-   }
+   /* This callback is installed only on V9+, so this selects every internal
+    * fullscreen-blitter draw on the affected V9-V10 hardware path. */
+   bool needs_workaround = scr->dev.arch < 11;
+
+   if (pctx->blit_depth_bias_override == 2) {
+      const char *dynamic =
+         debug_get_option("PAN_BLIT_DEPTH_BIAS_DYNAMIC", "off");
+      int8_t selected;
+      if (strcmp(dynamic, "off") == 0) {
+         selected = -1;
+      } else if (strcmp(dynamic, "on") == 0) {
+         selected = 1;
+      } else {
+         mesa_loge("PAN_BLIT_DEPTH_BIAS_DYNAMIC must be off or on; got '%s'",
+                   dynamic);
+         selected = -1;
+         dynamic = "off";
+      }
+
+      if (selected != pctx->blit_depth_bias_dynamic_last) {
+         mesa_logi("PAN_BLIT_DEPTH_BIAS_DYNAMIC=%s", dynamic);
+         pctx->blit_depth_bias_dynamic_last = selected;
+      }
+      needs_workaround = selected > 0;
+   } else if (pctx->blit_depth_bias_override < 0) {
+      needs_workaround = false;
+   }
 
    struct pipe_rasterizer_state *old_rast = NULL, *new_rast;
    if (needs_workaround) {
       /* panfrost_rasterizer always has pipe_rasterizer_state as the first
@@ -156,8 +170,32 @@ panfrost_blitter_draw_rectangle(struct blitter_context *blitter,
 struct blitter_context *
 panfrost_blitter_create(struct pipe_context *pipe)
 {
+   struct panfrost_context *ctx = pan_context(pipe);
    struct blitter_context *blitter;
 
+   const char *override =
+      debug_get_option("PAN_BLIT_DEPTH_BIAS", "auto");
+   ctx->blit_depth_bias_dynamic_last = -2;
+   if (strcmp(override, "auto") == 0) {
+      ctx->blit_depth_bias_override = 0;
+   } else if (strcmp(override, "off") == 0) {
+      ctx->blit_depth_bias_override = -1;
+   } else if (strcmp(override, "on") == 0) {
+      ctx->blit_depth_bias_override = 1;
+   } else if (strcmp(override, "dynamic") == 0) {
+      ctx->blit_depth_bias_override = 2;
+   } else {
+      mesa_loge("PAN_BLIT_DEPTH_BIAS must be auto, off, on, or dynamic; "
+                "got '%s'", override);
+      ctx->blit_depth_bias_override = 0;
+      override = "auto";
+   }
+
+   /* The benchmark runner requires this acknowledgement before comparing
+    * labels, so an uninstrumented driver cannot silently produce an A/B.
+    */
+   mesa_logi("PAN_BLIT_DEPTH_BIAS=%s", override);
+
    blitter = util_blitter_create(pipe);
 
    if (pan_screen(pipe->screen)->dev.arch >= 9)
