+  int64_t now_us;
+
+  now_us = g_get_monotonic_time ();
+
+  g_mutex_lock (&renderer->hw_encode_mutex);
+  cooldown_until_us = renderer->hw_encode_cooldown_until_us;
+  g_mutex_unlock (&renderer->hw_encode_mutex);
+
+  if (now_us < cooldown_until_us)
+    {
