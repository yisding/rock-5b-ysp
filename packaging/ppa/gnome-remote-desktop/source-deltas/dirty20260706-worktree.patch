+             " us); using software encoding for %" G_GINT64_FORMAT " us",
+             reason, (gint64) duration_us, (gint64) HW_ENCODE_COOLDOWN_US);
+  schedule_hw_encode_cooldown_recovery (renderer, cooldown_until_us);
+  request_full_refresh_for_all_surfaces (renderer);
+}
