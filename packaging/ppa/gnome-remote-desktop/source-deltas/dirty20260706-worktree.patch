+static void
+note_hw_encode_duration (GrdRdpRenderer *renderer,
+                         int64_t         duration_us)
+{
+  const char *reason = NULL;
+  int64_t now_us = g_get_monotonic_time ();
+  int64_t cooldown_until_us = 0;
+  gboolean started_cooldown = FALSE;
+
+  g_mutex_lock (&renderer->hw_encode_mutex);
+
+  if (duration_us >= HW_ENCODE_STALL_THRESHOLD_US)
+    {
+      reason = "single slow encode";
+    }
+  else if (duration_us >= HW_ENCODE_SLOW_THRESHOLD_US)
+    {
+      if (renderer->slow_hw_encode_window_start_us == 0 ||
+          now_us - renderer->slow_hw_encode_window_start_us >
+          HW_ENCODE_SLOW_WINDOW_US)
+        {
+          renderer->slow_hw_encode_window_start_us = now_us;
+          renderer->slow_hw_encode_samples = 0;
+        }
+
+      ++renderer->slow_hw_encode_samples;
+      if (renderer->slow_hw_encode_samples >= HW_ENCODE_SLOW_SAMPLE_THRESHOLD)
+        reason = "repeated slow encodes";
+    }
+  else if (renderer->slow_hw_encode_window_start_us != 0 &&
+           now_us - renderer->slow_hw_encode_window_start_us >
+           HW_ENCODE_SLOW_WINDOW_US)
+    {
+      renderer->slow_hw_encode_window_start_us = 0;
+      renderer->slow_hw_encode_samples = 0;
+    }
+
+  if (reason && now_us >= renderer->hw_encode_cooldown_until_us)
+    {
+      cooldown_until_us = now_us + HW_ENCODE_COOLDOWN_US;
+      renderer->hw_encode_cooldown_until_us = cooldown_until_us;
+      renderer->slow_hw_encode_window_start_us = 0;
+      renderer->slow_hw_encode_samples = 0;
+      started_cooldown = TRUE;
+    }
+
+  g_mutex_unlock (&renderer->hw_encode_mutex);
+
+  if (!started_cooldown)
+    return;
+
