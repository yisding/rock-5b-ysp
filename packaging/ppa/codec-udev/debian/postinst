#!/bin/sh
set -e

verify_codec_node() {
	node=$1

	if [ ! -e "$node" ]; then
		echo "rk3588-codec-udev: expected device node is missing: $node" >&2
		return 1
	fi
	permissions=$(stat -c '%G:%a' "$node")
	if [ "$permissions" != "video:660" ]; then
		echo "rk3588-codec-udev: $node has $permissions; expected video:660" >&2
		# The packaged rule lives in /usr/lib/udev/rules.d. A same-named file in
		# /etc/udev/rules.d fully MASKS it, and kernel-drivers/scripts/'s own
		# header tells users to copy it there by hand -- so an older manual copy
		# (one without the dma_heap line) silently wins and this check fails with
		# no hint as to why.
		if [ -e /etc/udev/rules.d/99-rockchip-codec.rules ]; then
			echo "rk3588-codec-udev: NOTE /etc/udev/rules.d/99-rockchip-codec.rules" >&2
			echo "rk3588-codec-udev: exists and MASKS the packaged rule in" >&2
			echo "rk3588-codec-udev: /usr/lib/udev/rules.d. Remove the /etc copy so the" >&2
			echo "rk3588-codec-udev: package's rule takes effect, then reconfigure." >&2
		fi
		return 1
	fi
}

trigger_codec_node() {
	sysfs_path=$1
	node=$2

	[ -e "$sysfs_path" ] || return 0
	if ! udevadm trigger --action=change --settle "$sysfs_path"; then
		echo "rk3588-codec-udev: failed to retrigger $sysfs_path" >&2
		return 1
	fi
	verify_codec_node "$node"
}

if [ "$1" = "configure" ] && [ -S /run/udev/control ]; then
	if ! udevadm control --reload-rules; then
		echo "rk3588-codec-udev: failed to reload udev rules" >&2
		exit 1
	fi
	trigger_codec_node /sys/class/mpp_class/mpp_service /dev/mpp_service
	trigger_codec_node /sys/class/misc/rga /dev/rga
	for sysfs_path in /sys/class/*/iep; do
		trigger_codec_node "$sysfs_path" /dev/iep
	done
	for sysfs_path in /sys/class/dma_heap/*; do
		[ -e "$sysfs_path" ] || continue
		trigger_codec_node "$sysfs_path" "/dev/dma_heap/${sysfs_path##*/}"
	done
fi

#DEBHELPER#
exit 0
