#!/bin/sh
# SPDX-FileCopyrightText: 2026 Yi Ding
# SPDX-License-Identifier: GPL-2.0-only
set -e
NAME=rk3588-vcodec
VERSION=1.0
case "$1" in
  remove|upgrade|deconfigure)
    if command -v dkms >/dev/null 2>&1; then
      dkms remove -m "$NAME" -v "$VERSION" --all 2>/dev/null || true
    fi
    ;;
esac
exit 0
