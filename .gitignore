# Agent scratch directories (present on dev boxes, never content-bearing)
.agents/
.codex/
.grd-debug/

# Local linked or nested worktrees are independent Git checkouts, not content
# owned by this repository.
.worktrees/

# Built binaries never live in git — built .debs and dkms build output are
# already covered by per-subdir .gitignores (packaging/*/.gitignore).
# Publication policy for built artifacts: see packaging/README.md.
packaging/ppa/out/
downloads/
*.deb
*.ddeb
*.changes
*.buildinfo
*.dsc
*.orig.tar.*
*.debian.tar.*
*.ko
*.dtb
*.dtbo
*.img
*.bin
*.tar.zst

# Accidental in-tree FFmpeg configure/build residue. Package builds should use
# packaging/ffmpeg-rockchip81/build/ or /tmp, not a root-level ffbuild/.
ffbuild/

# On-board ABI replay output is generated per boot/profile.
kernel-drivers/tests/logs/

# Python validation helpers.
__pycache__/
*.pyc

# Local board flash dumps and erase-time backups. These are recovery artifacts,
# not source inputs.
spi-backups/
spi-*.bin
