From d6a6e4cf5f84fe33a54510c55645eb664fd7edd9 Mon Sep 17 00:00:00 2001
From: nyanmisaka <nst799610810@gmail.com>
Date: Sun, 19 Oct 2025 16:11:31 +0800
Subject: [PATCH 5/7] normal: fix inverted RGB/BGR order in FBCE of RGA3

Signed-off-by: nyanmisaka <nst799610810@gmail.com>
(cherry picked from commit 1d330cc28551943bed3380261a5a9c6fbd58ff53)
---
 core/NormalRga.cpp | 13 +++++++++++++
 include/RgaApi.h   |  1 +
 2 files changed, 14 insertions(+)

diff --git a/core/NormalRga.cpp b/core/NormalRga.cpp
index 5584a32..c425e0e 100644
--- a/core/NormalRga.cpp
+++ b/core/NormalRga.cpp
@@ -679,6 +679,19 @@ int RgaBlit(rga_info *src, rga_info *dst, rga_info *src1) {
         ALOGD("dst: Fd/handle = %.2d , buf = %p, mmuFlag = %d, mmuType = %d\n", dstFd, dstBuf, dst->mmuFlag, dstType);
     }
 
+    /* rga3 fixup inverted RGB/BGR order in FBCE */
+    if (dst && dst->rd_mode == fbc_mode &&
+        rga_version_compare(ctx->mDriverVersion, (struct rga_version_t){ 1, 3, 9, {0} }) < 0) {
+        switch (relDstRect.format) {
+        case RK_FORMAT_RGBA_8888:
+            relDstRect.format = RK_FORMAT_BGRA_8888;
+            break;
+        case RK_FORMAT_BGRA_8888:
+            relDstRect.format = RK_FORMAT_RGBA_8888;
+            break;
+        }
+    }
+
     relSrcRect.format = RkRgaCompatibleFormat(relSrcRect.format);
     relDstRect.format = RkRgaCompatibleFormat(relDstRect.format);
     if (isRectValid(relSrc1Rect))
diff --git a/include/RgaApi.h b/include/RgaApi.h
index 0cb0624..e47c4f8 100644
--- a/include/RgaApi.h
+++ b/include/RgaApi.h
@@ -34,6 +34,7 @@
 #include "rga.h"
 
 #define RGA_NORMAL_DST_FULL_CSC_FIXUP 1
+#define RGA_NORMAL_FBCE_RGB_BGR_FIXUP 1
 
 #ifdef __cplusplus
 extern "C"{
-- 
2.53.0

