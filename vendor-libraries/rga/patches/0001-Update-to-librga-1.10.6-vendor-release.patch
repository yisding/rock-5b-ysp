index 0000000..3d522fd
--- /dev/null
+++ b/samples/cfa_demo/src/rga_cfa_a2_demo.cpp
@@ -0,0 +1,192 @@
+/*
+ * Copyright (C) 2022  Rockchip Electronics Co., Ltd.
+ * Authors:
+ *     YuQiaowei <cerf.yu@rock-chips.com>
+ *
