+
+    usage |= IM_CFA;
+
+    opt.version = RGA_CURRENT_API_VERSION;
+    memcpy(&opt.cfa_config, cfa_config, sizeof(im_cfa_t));
+    opt.cfa_config.src1_handle = src1.handle;
+    opt.cfa_config.dst1_handle = dst1.handle;
