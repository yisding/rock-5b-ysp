diff --git a/drivers/video/rockchip/rga-rewrite/rga_rewrite.c b/drivers/video/rockchip/rga-rewrite/rga_rewrite.c
index 2b4cf548391f..e087ff0c96a0 100644
--- a/drivers/video/rockchip/rga-rewrite/rga_rewrite.c
+++ b/drivers/video/rockchip/rga-rewrite/rga_rewrite.c
@@ -1937,6 +1937,11 @@ static int rk_rga_validate_mmio_size(u32 minimum, resource_size_t size)
 	return size < minimum ? -EINVAL : 0;
 }
 
+static unsigned long rk_rga_irq_flags(bool has_external_iommu)
+{
+	return has_external_iommu ? IRQF_SHARED : IRQF_ONESHOT;
+}
+
 static int rk_rga_check_dma_sgt(struct sg_table *sgt, const char *source,
 				size_t required_size, dma_addr_t *iova_out,
 				bool log_errors)
@@ -11934,6 +11940,10 @@ static void rk_rga_mmio_size_kunit(struct kunit *test)
 			rk_rga_validate_mmio_size(RK_RGA3_MIN_REG_SIZE,
 						  RK_RGA3_MIN_REG_SIZE),
 			0);
+	KUNIT_EXPECT_EQ(test, rk_rga_irq_flags(false),
+			(unsigned long)IRQF_ONESHOT);
+	KUNIT_EXPECT_EQ(test, rk_rga_irq_flags(true),
+			(unsigned long)IRQF_SHARED);
 }
 
 static void rk_rga_hw_version_kunit(struct kunit *test)
@@ -23493,6 +23503,7 @@ static int rk_rga_hw_probe(struct platform_device *pdev)
 	struct resource *res;
 	struct rk_rga_hw *hw;
 	u32 raw_version = 0;
+	unsigned long irq_flags;
 	int irq;
 	int ret;
 
@@ -23576,9 +23587,16 @@ static int rk_rga_hw_probe(struct platform_device *pdev)
 		if (ret)
 			return ret;
 	}
+	/*
+	 * RK3588 RGA3 shares its level IRQ with the external IOMMU. The hard
+	 * handler clears RGA status before waking the completion thread, so
+	 * masking the entire shared line until that thread exits is unnecessary
+	 * and conflicts with rockchip-iommu's non-oneshot IRQ registration.
+	 */
+	irq_flags = rk_rga_irq_flags(!!hw->iommu_node);
 
 	ret = devm_request_threaded_irq(dev, hw->irq, rk_rga_irq_handler,
-					rk_rga_irq_thread, IRQF_ONESHOT,
+					rk_rga_irq_thread, irq_flags,
 					dev_name(dev), hw);
 	if (ret)
 		return ret;
