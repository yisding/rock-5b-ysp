CONFORMANCE_TARGET=forward-port
CONFORMANCE_TARGET_DESCRIPTION="BSP drivers forward-ported to the maintained kernel"
CONFORMANCE_TARGET_REQUIRED_CONFIG="CONFIG_ROCKCHIP_MPP_SERVICE=y CONFIG_VIDEO_ROCKCHIP_RGA=y"
CONFORMANCE_TARGET_FORBIDDEN_CONFIG="CONFIG_ROCKCHIP_MPP_REWRITE=y CONFIG_ROCKCHIP_RGA_REWRITE=y"
CONFORMANCE_TARGET_COUNTER_DEFAULTS=0
CONFORMANCE_TARGET_REQUIRE_DMESG=0
