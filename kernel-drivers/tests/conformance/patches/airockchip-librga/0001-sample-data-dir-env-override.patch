+/*
+ * Resolve the base directory for sample .bin fixtures. Upstream demos hardcode
+ * LOCAL_FILE_PATH="/data" (an Android/vendor convention) which is absent and not
+ * writable on a stock Linux rootfs. Honor $RGA_SAMPLE_DATA_DIR when set so the
+ * conformance harness can redirect reads/writes to a user-accessible scratch
+ * dir; otherwise fall back to the caller-provided path (unchanged behavior).
+ */
+static const char *rga_sample_dir(const char *path) {
+    const char *env = getenv("RGA_SAMPLE_DATA_DIR");
+    return (env && env[0]) ? env : path;
+}
