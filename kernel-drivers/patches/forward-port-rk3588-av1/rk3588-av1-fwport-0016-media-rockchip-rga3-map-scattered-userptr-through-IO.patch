+	    dma_addr > U32_MAX || dma_end > U32_MAX) {
+		if (log_errors)
+			rga_err("reject %s DMA mapping: 32-bit IOVA span overflow, iova = %pad, size = %zu, end = 0x%llx\n",
+				source, &dma_addr, size, dma_end);
