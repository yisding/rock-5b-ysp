+	job_buf->rga2_bounce[job_buf->rga2_bounce_count] = bounce;
+	job_buf->rga2_bounce_origin[job_buf->rga2_bounce_count] = buffer;
+	job_buf->rga2_bounce_count++;
+
+	*use_dma_address = true;
+	return bounce->sgt;
+}
