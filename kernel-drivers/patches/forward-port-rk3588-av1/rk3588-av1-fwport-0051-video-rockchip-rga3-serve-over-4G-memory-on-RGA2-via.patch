 .../video/rockchip/rga3/include/rga_dma_buf.h |   7 +
 drivers/video/rockchip/rga3/include/rga_drv.h |   9 +
 drivers/video/rockchip/rga3/include/rga_mm.h  |   1 +
 drivers/video/rockchip/rga3/rga_dma_buf.c     | 197 ++++++++----
 drivers/video/rockchip/rga3/rga_job.c         |  24 +-
