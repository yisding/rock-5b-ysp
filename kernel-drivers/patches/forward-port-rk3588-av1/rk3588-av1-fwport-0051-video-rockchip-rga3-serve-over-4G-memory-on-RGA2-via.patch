+	bounce = kzalloc(sizeof(*bounce), GFP_KERNEL);
+	if (bounce == NULL)
+		return ERR_PTR(-ENOMEM);
+
+	switch (buffer->type) {
+	case RGA_DMA_BUFFER:
+	case RGA_DMA_BUFFER_PTR:
