From 4401383a6d9b539edb686140c7e6c380947b4ddd Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Thu, 23 Jul 2026 06:57:49 -0700
Subject: [PATCH] video: rockchip: rga3: reject 16-misaligned IOMMU window base

RGA3 fetches a window base on a 16-byte granularity (the low 4 bits of the
*_BASE registers are ignored). The scattered-userptr path carries the original
sub-page byte offset in the base (iova + real_offset) and, for a shadow_page
head, leaves the bytes before real_offset zeroed. So an IOMMU-mapped source
whose byte offset is not 16-byte aligned makes the hardware read the zeroed
shadow head and silently return all-zero pixels -- surfaced by the first
on-hardware run of the scattered-userptr IOMMU fuzzer (correct only at
src_off in {0,16,32,48}, all-zero output otherwise).

A sub-16-byte residual cannot be expressed as a whole-pixel window offset for
every format, so make rga_mm_get_buffer_info() reject a non-16-aligned
IOMMU base with -EINVAL instead of corrupting data silently. Aligned userptr
and dma-buf imports always land on a >=page-aligned base and are unaffected.

Fully supporting a pixel-aligned-but-not-16-aligned scattered source (via a
16-aligned base plus a WIN_ACT_OFF x-offset) can follow as a separate,
format-aware change.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
---
 drivers/video/rockchip/rga3/rga_mm.c | 29 ++++++++++++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/drivers/video/rockchip/rga3/rga_mm.c b/drivers/video/rockchip/rga3/rga_mm.c
index 131c349947932..6ce00f363080a 100644
--- a/drivers/video/rockchip/rga3/rga_mm.c
+++ b/drivers/video/rockchip/rga3/rga_mm.c
@@ -16,6 +16,13 @@
 #include "rga_hw_config.h"
 #include "rga_debugger.h"
 
+/*
+ * RGA3 fetches a window base address on a 16-byte granularity (the low 4 bits
+ * of the *_BASE registers are ignored by the hardware), so an IOMMU-mapped base
+ * must be 16-byte aligned to read/write the intended bytes.
+ */
+#define RGA_IOMMU_ADDR_ALIGN 16
+
 struct rga_shadow_node {
 	int page_idx;
 	struct page *orig_page;
@@ -2054,6 +2061,28 @@ static int rga_mm_get_buffer_info(struct rga_job *job,
 			return -EFAULT;
 		}
 
+		/*
+		 * The RGA3 window base is fetched on a 16-byte granularity: the
+		 * low 4 bits of yrgb_addr are dropped by the hardware. The
+		 * scattered-userptr path carries the original sub-page byte
+		 * offset in the base (iova + real_offset) and, for a shadow_page
+		 * head, leaves the bytes before real_offset zeroed -- so a base
+		 * whose offset is not 16-byte aligned makes RGA read the zeroed
+		 * head and silently return all-zero pixels (see
+		 * findings/2026-07-23-rga-scattered-userptr-unaligned-src-zero-output).
+		 * Sub-16 alignment cannot be expressed as a whole-pixel window
+		 * offset for every format, so reject it loudly here instead of
+		 * corrupting data silently. Aligned userptr and dma-buf imports
+		 * always land on a >=page-aligned base and are unaffected.
+		 */
+		if (!IS_ALIGNED(addr, RGA_IOMMU_ADDR_ALIGN)) {
+			rga_job_err(job,
+				"core[%d] handle[%d] iova 0x%llx not %d-byte aligned; unaligned scattered userptr is unsupported\n",
+				job->core, internal_buffer->handle,
+				(unsigned long long)addr, RGA_IOMMU_ADDR_ALIGN);
+			return -EINVAL;
+		}
+
 		break;
 	case RGA_MMU:
 	default:
