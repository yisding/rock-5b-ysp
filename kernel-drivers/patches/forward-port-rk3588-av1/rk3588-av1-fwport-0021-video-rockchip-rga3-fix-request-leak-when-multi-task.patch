From b6ea72cb5f56eb08083abf0dc82251890ad5d5f1 Mon Sep 17 00:00:00 2001
From: Yu Qiaowei <cerf.yu@rock-chips.com>
Date: Thu, 2 Apr 2026 17:18:28 +0800
Subject: [PATCH 21/39] video: rockchip: rga3: fix request leak when multi-task
 submit failed

Change-Id: Ic1d96f5cf05bd705043ffe7c33f4c4f9c0da88fe
Signed-off-by: Yu Qiaowei <cerf.yu@rock-chips.com>
(cherry picked from commit 3727985456c12f09273c6507335d145a03ffc116)
---
 drivers/video/rockchip/rga3/rga_drv.c | 9 +++------
 1 file changed, 3 insertions(+), 6 deletions(-)

diff --git a/drivers/video/rockchip/rga3/rga_drv.c b/drivers/video/rockchip/rga3/rga_drv.c
index 052938214e99..6af4e607aef7 100644
--- a/drivers/video/rockchip/rga3/rga_drv.c
+++ b/drivers/video/rockchip/rga3/rga_drv.c
@@ -807,15 +807,12 @@ static long rga_ioctl_request_submit(unsigned long arg, bool run_enbale)
 		ret = rga_request_submit(request);
 		if (ret < 0) {
 			rga_err("request[%d] submit failed!\n", user_request.id);
-			return -EFAULT;
-		}
-
-		if (request->sync_mode == RGA_BLIT_ASYNC) {
+		} else if (request->sync_mode == RGA_BLIT_ASYNC) {
 			user_request.release_fence_fd = request->release_fence_fd;
 			if (copy_to_user((struct rga_req *)arg,
 					 &user_request, sizeof(user_request))) {
 				rga_err("copy_to_user failed\n");
-				return -EFAULT;
+				ret = -EFAULT;
 			}
 		}
 	}
@@ -824,7 +821,7 @@ static long rga_ioctl_request_submit(unsigned long arg, bool run_enbale)
 	rga_request_put(request);
 	mutex_unlock(&request_manager->lock);
 
-	return 0;
+	return ret;
 }
 
 static long rga_ioctl_request_cancel(unsigned long arg)
