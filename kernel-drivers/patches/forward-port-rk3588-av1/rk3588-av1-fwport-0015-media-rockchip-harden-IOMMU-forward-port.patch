@@ -154,6 +154,7 @@ struct av1dec_dev {
 
 	void __iomem *reg_base[AV1DEC_CLASS_BUTT];
 	int irq[AV1DEC_CLASS_BUTT];
+	bool afbc_irq_active;
 };
 
