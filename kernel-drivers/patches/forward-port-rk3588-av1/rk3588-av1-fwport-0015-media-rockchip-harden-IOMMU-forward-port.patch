+static int rk_iommu_runtime_get_if_active(struct rk_iommu *iommu)
+{
+	int ret;
+
+	ret = pm_runtime_get_if_in_use(iommu->dev);
+	if (ret < 0)
+		return ret;
+	if (!ret)
+		return -EAGAIN;
+
+	return 0;
+}
+
