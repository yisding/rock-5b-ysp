 			dev_err(iommu->dev, "BUS_ERROR occurred at %pad\n", &iova);
+			if (!notified && iommu->domain != &rk_identity_domain) {
+				int handler_flags = ROCKCHIP_IOMMU_FAULT_BUS_ERROR;
+				int fault_ret;
