From 8524d74a792520572f08406d7f25aa3441f66ed8 Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Wed, 22 Jul 2026 08:16:21 -0700
Subject: [PATCH 67/69] video: rockchip: rga: balance get-buffer error paths

After taking an internal-buffer reference, every error must drop
it and clear the caller output pointer. Route buffer-info failures
through the shared cleanup and make the ownership contract unambiguous.

Signed-off-by: rkvenc forward-port <forward-port@local>
---
 drivers/video/rockchip/rga3/rga_mm.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/video/rockchip/rga3/rga_mm.c b/drivers/video/rockchip/rga3/rga_mm.c
index ce9d50a0e5c7d..b3d15efa47c7c 100644
--- a/drivers/video/rockchip/rga3/rga_mm.c
+++ b/drivers/video/rockchip/rga3/rga_mm.c
@@ -2124,7 +2124,7 @@ static int rga_mm_get_buffer(struct rga_mm *mm,
 	if (ret < 0) {
 		rga_job_err(job, "handle[%ld] failed to get internal buffer info!\n",
 			(unsigned long)handle);
-		return ret;
+		goto put_internal_buffer;
 	}
 
 	if (internal_buffer->size < require_size) {
@@ -2155,6 +2155,7 @@ static int rga_mm_get_buffer(struct rga_mm *mm,
 	kref_put(&internal_buffer->refcount, rga_mm_kref_release_buffer);
 	mutex_unlock(&mm->lock);
 
+	*buf = NULL;
 	return ret;
 
 }
-- 
