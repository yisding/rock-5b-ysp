From 71bcd51ccb4387e6f6564ce2b02a7fcb6a886a5e Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Fri, 3 Jul 2026 19:43:41 -0700
Subject: [PATCH 08/39] video: rockchip: rga: depend on ROCKCHIP_IOMMU and
 harden version string

Add an explicit ROCKCHIP_IOMMU dependency to ROCKCHIP_MULTI_RGA (the RGA2/
RGA3 blocks are behind the Rockchip IOMMU), and format the scheduler version
string with sizeof(version.str) instead of a hardcoded length of 10 so the
buffer size stays in sync with the struct. Add the RGA vendor devicetree
binding.

Co-Authored-By: Claude Opus 4.8 (1M context) <noreply@anthropic.com>
---
 .../bindings/media/rockchip,rga-vendor.yaml   | 45 +++++++++++++++++++
 drivers/video/rockchip/rga3/Kconfig           |  2 +-
 drivers/video/rockchip/rga3/rga2_reg_info.c   |  3 +-
 drivers/video/rockchip/rga3/rga3_reg_info.c   |  3 +-
 4 files changed, 50 insertions(+), 3 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/media/rockchip,rga-vendor.yaml

diff --git a/Documentation/devicetree/bindings/media/rockchip,rga-vendor.yaml b/Documentation/devicetree/bindings/media/rockchip,rga-vendor.yaml
new file mode 100644
index 000000000000..dea535e600da
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/rockchip,rga-vendor.yaml
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rga-vendor.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip vendor RGA2/RGA3 nodes
+
+maintainers:
+  - RKMPP forward-port maintainers <rkmpp-forward-port@example.invalid>
+
+description:
+  Vendor RGA nodes used by Rockchip's librga-compatible driver. RK3588 exposes
+  two RGA3 cores and one RGA2 core as separate platform devices.
+
+properties:
+  compatible:
+    enum:
+      - rockchip,rga2_core0
+      - rockchip,rga3_core0
+      - rockchip,rga3_core1
+
+  reg: true
+  interrupts: true
+  interrupt-names: true
+  clocks: true
+  clock-names: true
+  iommus: true
+  power-domains: true
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: true
+
+examples:
+  - |
+    rga@fdb60000 {
+        compatible = "rockchip,rga3_core0";
+        reg = <0x0 0xfdb60000 0x0 0x1000>;
+        interrupts = <114>;
+        interrupt-names = "rga3_core0_irq";
+    };
+...
diff --git a/drivers/video/rockchip/rga3/Kconfig b/drivers/video/rockchip/rga3/Kconfig
index 2e56888814e2..5b2d4c0064aa 100644
--- a/drivers/video/rockchip/rga3/Kconfig
+++ b/drivers/video/rockchip/rga3/Kconfig
@@ -1,7 +1,7 @@
 # SPDX-License-Identifier: GPL-2.0
 menuconfig ROCKCHIP_MULTI_RGA
 	tristate "MULTI_RGA"
-	depends on ARCH_ROCKCHIP
+	depends on ARCH_ROCKCHIP && ROCKCHIP_IOMMU
 	default y
 	select SYNC_FILE
 	help
diff --git a/drivers/video/rockchip/rga3/rga2_reg_info.c b/drivers/video/rockchip/rga3/rga2_reg_info.c
index 7f5e4c9e1862..5e4c69a67357 100644
--- a/drivers/video/rockchip/rga3/rga2_reg_info.c
+++ b/drivers/video/rockchip/rga3/rga2_reg_info.c
@@ -3247,7 +3247,8 @@ static int rga2_get_version(struct rga_scheduler_t *scheduler)
 	if (!major_version && !minor_version)
 		major_version = 2;
 
-	snprintf(scheduler->version.str, 10, "%x.%01x.%05x", major_version,
+	snprintf(scheduler->version.str, sizeof(scheduler->version.str),
+		 "%x.%01x.%05x", major_version,
 		 minor_version, svn_version);
 
 	scheduler->version.major = major_version;
diff --git a/drivers/video/rockchip/rga3/rga3_reg_info.c b/drivers/video/rockchip/rga3/rga3_reg_info.c
index 28f86a67f58b..9bba84af71e3 100644
--- a/drivers/video/rockchip/rga3/rga3_reg_info.c
+++ b/drivers/video/rockchip/rga3/rga3_reg_info.c
@@ -2196,7 +2196,8 @@ static int rga3_get_version(struct rga_scheduler_t *scheduler)
 	minor_version = (reg_version & RGA3_MINOR_VERSION_MASK) >> 20;
 	svn_version = (reg_version & RGA3_SVN_VERSION_MASK);
 
-	snprintf(scheduler->version.str, 10, "%x.%01x.%05x", major_version,
+	snprintf(scheduler->version.str, sizeof(scheduler->version.str),
+		 "%x.%01x.%05x", major_version,
 		 minor_version, svn_version);
 
 	scheduler->version.major = major_version;
