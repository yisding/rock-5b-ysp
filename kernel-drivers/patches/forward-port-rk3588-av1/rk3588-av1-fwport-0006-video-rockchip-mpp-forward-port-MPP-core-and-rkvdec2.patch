+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Vendor CCU scheduling mode selected by the decoder driver.
+  rockchip,normal-rates:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      Normal operating clock rates programmed by the vendor MPP driver.
+  rockchip,skip-pmu-idle-request:
+    $ref: /schemas/types.yaml#/definitions/flag
+    description:
+      Present when the driver must skip Rockchip PMU idle request calls.
