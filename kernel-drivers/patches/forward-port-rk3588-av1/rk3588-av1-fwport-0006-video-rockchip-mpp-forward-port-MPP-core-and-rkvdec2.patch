+      Phandle to the vendor MPP service coordinator node.
+
+  rockchip,ccu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the decoder CCU node used by dual-core decoder instances.
+
+  rockchip,sram:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the SRAM pool used for decoder row-column buffers.
+
