+required:
+  - compatible
+
+additionalProperties: true
+
+examples:
+  - |
+    rkvdec-ccu@fdc30000 {
+        compatible = "rockchip,rkv-decoder-v2-ccu";
+        reg = <0x0 0xfdc30000 0x0 0x100>;
+        reg-names = "ccu";
+        rockchip,ccu-mode = <1>;
+    };
