+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/rockchip,rkvdec2.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Rockchip vendor RKVDEC2 decoder nodes
+
+maintainers:
+  - RKMPP forward-port maintainers <rkmpp-forward-port@example.invalid>
+
+description:
+  Vendor MPP VDPU381/RKVDEC2 decoder binding used by Rockchip userspace through
+  /dev/mpp_service. The CCU node coordinates the two decoder cores; board files
+  may convert base video-codec nodes to the vendor-compatible core binding.
+
+properties:
+  compatible:
+    enum:
+      - rockchip,rkv-decoder-v2
+      - rockchip,rkv-decoder-v2-ccu
+
+  reg: true
+  reg-names: true
+  interrupts: true
+  interrupt-names: true
+  clocks: true
+  clock-names: true
+  assigned-clocks: true
+  assigned-clock-rates: true
