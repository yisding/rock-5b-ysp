+    $ref: /schemas/types.yaml#/definitions/uint32-matrix
+    items:
+      minItems: 2
+      maxItems: 2
+    description:
+      Decoder row-column buffer register and size pairs.
+  rockchip,rcb-min-width:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description:
+      Minimum frame width at which the row-column buffer path is enabled.
