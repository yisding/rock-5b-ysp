From 13afe70c8271cdb30b07ae6760fc2232f3b95cfb Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Sat, 4 Jul 2026 12:19:30 -0700
Subject: [PATCH 13/39] iommu: rockchip: restore large DMA segment support

---
 drivers/iommu/rockchip-iommu.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/iommu/rockchip-iommu.c b/drivers/iommu/rockchip-iommu.c
index 0f19b779e6d9..4635130ce80e 100644
--- a/drivers/iommu/rockchip-iommu.c
+++ b/drivers/iommu/rockchip-iommu.c
@@ -1211,6 +1211,18 @@ static struct iommu_device *rk_iommu_probe_device(struct device *dev)
 	data->link = device_link_add(dev, iommu->dev,
 				     DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME);
 
+	/*
+	 * RGA and other Rockchip multimedia clients can depend on dma_map_sg()
+	 * returning a single contiguous IOVA span for an imported buffer. Allow
+	 * the DMA layer to merge the full 32-bit IOMMU aperture into one segment.
+	 */
+	if (!dev->dma_parms)
+		dev->dma_parms = kzalloc(sizeof(*dev->dma_parms), GFP_KERNEL);
+	if (!dev->dma_parms)
+		return ERR_PTR(-ENOMEM);
+
+	dma_set_max_seg_size(dev, DMA_BIT_MASK(32));
+
 	return &iommu->iommu;
 }
 
