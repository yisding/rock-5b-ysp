+	if (stage->sgt)
+		rga_free_sgt(&stage->sgt);
+	if (stage->vaddr)
+		vunmap(stage->vaddr);
+	if (stage->pages) {
+		for (i = 0; i < stage->page_count; i++)
+			if (stage->pages[i])
+				__free_page(stage->pages[i]);
+		kvfree(stage->pages);
+	}
+	if (stage->origin)
+		dma_buf_put(stage->origin);
+	kfree(stage);
