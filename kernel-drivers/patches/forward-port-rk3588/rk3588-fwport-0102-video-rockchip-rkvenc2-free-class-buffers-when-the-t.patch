From a3d8ad5ad95a3db3f2556fa3ce9e884ecd991687 Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Sun, 22 Nov 2026 07:03:31 -0800
Subject: [PATCH 102/107] video: rockchip: rkvenc2: free class buffers when the
 task format is missing

rkvenc_alloc_task() extracts the request's register classes, which
allocates a buffer per class, and then derives the task format. When no
PIC-class register was written, rkvenc_task_get_format() fails and the
code jumped straight to kfree(task), leaking every class buffer. Any
user with access to /dev/mpp_service could repeat the submission and
grow unaccounted kernel memory without bound.

Free the class buffers on that path too.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/video/rockchip/mpp/mpp_rkvenc2.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/video/rockchip/mpp/mpp_rkvenc2.c b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
index bf22a6823163..aab92e0990bf 100644
--- a/drivers/video/rockchip/mpp/mpp_rkvenc2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
@@ -1243,7 +1243,7 @@ static void *rkvenc_alloc_task(struct mpp_session *session,
 	/* get format */
 	ret = rkvenc_task_get_format(mpp, task);
 	if (ret)
-		goto free_task;
+		goto free_class;
 	/* process fd in register */
 	if (!(msgs->flags & MPP_FLAGS_REG_FD_NO_TRANS)) {
 		u32 i, j;
@@ -1342,6 +1342,7 @@ static void *rkvenc_alloc_task(struct mpp_session *session,
 	mpp_task_dump_mem_region(mpp, mpp_task);
 	mpp_task_dump_reg(mpp, mpp_task);
 	mpp_task_finalize(session, mpp_task);
+free_class:
 	/* free class register buffer */
 	rkvenc_free_class_msg(task);
 free_task:
