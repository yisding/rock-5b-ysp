 		sh = msg->src.act_h;
 
-		if ((rotate_mode == 1) | (rotate_mode == 3)) {
+		if ((rotate_mode == 1) || (rotate_mode == 3)) {
 			dw = msg->dst.act_h;
 			dh = msg->dst.act_w;
 		} else {
