 drivers/video/rockchip/rga3/rga2_reg_info.c | 2 +-
 drivers/video/rockchip/rga3/rga_drv.c       | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/drivers/video/rockchip/rga3/rga2_reg_info.c b/drivers/video/rockchip/rga3/rga2_reg_info.c
index e50093d9b40c8..9b1ae012fa8b7 100644
