From: rkvenc forward-port <forward-port@local>
Date: Tue, 21 Jul 2026 02:32:36 -0700
Subject: [PATCH 43/71] video: rockchip: rga3: accept legacy RGA2_GET_RESULT
 ioctl

Signed-off-by: rkvenc forward-port <forward-port@local>
---
 drivers/video/rockchip/rga3/include/rga.h | 1 +
 drivers/video/rockchip/rga3/rga_drv.c     | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/video/rockchip/rga3/include/rga.h b/drivers/video/rockchip/rga3/include/rga.h
index 7de682eab8707..06659667b65f2 100644
--- a/drivers/video/rockchip/rga3/include/rga.h
+++ b/drivers/video/rockchip/rga3/include/rga.h
@@ -27,6 +27,7 @@
 #define RGA_GET_VERSION			0x501b
 #define RGA_CACHE_FLUSH			0x501c
 
+#define RGA2_GET_RESULT			0x601a
 #define RGA2_GET_VERSION		0x601b
 #define RGA_IMPORT_DMA			0x601d
 #define RGA_RELEASE_DMA			0x601e
diff --git a/drivers/video/rockchip/rga3/rga_drv.c b/drivers/video/rockchip/rga3/rga_drv.c
index 84df6f8c14bc7..be8bb8b835b3d 100644
--- a/drivers/video/rockchip/rga3/rga_drv.c
+++ b/drivers/video/rockchip/rga3/rga_drv.c
@@ -1023,6 +1023,7 @@ static long rga_ioctl(struct file *file, uint32_t cmd, unsigned long arg)
 	case RGA_CACHE_FLUSH:
 	case RGA_FLUSH:
 	case RGA_GET_RESULT:
+	case RGA2_GET_RESULT:
 		break;
 	case RGA_GET_VERSION:
 		sscanf(rga->scheduler[i]->version.str, "%x.%x.%*x",
