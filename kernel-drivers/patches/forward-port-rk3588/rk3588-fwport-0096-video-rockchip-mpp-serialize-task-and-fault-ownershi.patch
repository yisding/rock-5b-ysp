--- a/drivers/iommu/vsi-iommu.c
+++ b/drivers/iommu/vsi-iommu.c
@@ -242,13 +242,17 @@ static irqreturn_t vsi_iommu_irq(int irq, void *dev_id)
 	spin_lock_irqsave(&iommu->lock, flags);
 
 	status = readl(iommu->regs + VSI_MMU_STATUS_BASE);
