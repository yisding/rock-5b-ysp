From f4d15aac4410252d94ee6885cbceae171e59b78b Mon Sep 17 00:00:00 2001
From: Yu Qiaowei <cerf.yu@rock-chips.com>
Date: Mon, 11 May 2026 20:17:49 +0800
Subject: [PATCH 35/87] video: rockchip: rga3: fix R2Y CSC mode bit shift
 definition

Fixes: dd79e039dca5 ("video: rockchip: rga3: fix check err when enable R2Y & Y2R")

Change-Id: I8d71ac5a106ce65818d8f193af2876f5f4b38276
Signed-off-by: Yu Qiaowei <cerf.yu@rock-chips.com>
(cherry picked from commit e519206d10d9baa63563432b9719953f0fc1881f)
---
 drivers/video/rockchip/rga3/include/rga.h | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/drivers/video/rockchip/rga3/include/rga.h b/drivers/video/rockchip/rga3/include/rga.h
index 3d185ac7ab28c..7de682eab8707 100644
--- a/drivers/video/rockchip/rga3/include/rga.h
+++ b/drivers/video/rockchip/rga3/include/rga.h
@@ -74,10 +74,10 @@ enum rga_csc_mode {
 	RGA_Y2R_BT601_FULL			= 0x2 << 0,
 	RGA_Y2R_BT709_LIMIT			= 0x3 << 0,
 	RGA_Y2R_MASK				= 0x3 << 0,
-	RGA_R2Y_BT601_LIMIT			= 0x2 << 0,
-	RGA_R2Y_BT601_FULL			= 0x1 << 0,
-	RGA_R2Y_BT709_LIMIT			= 0x3 << 0,
-	RGA_R2Y_MASK				= 0x3 << 0,
+	RGA_R2Y_BT601_LIMIT			= 0x2 << 2,
+	RGA_R2Y_BT601_FULL			= 0x1 << 2,
+	RGA_R2Y_BT709_LIMIT			= 0x3 << 2,
+	RGA_R2Y_MASK				= 0x3 << 2,
 };
 
 enum rga_memory_type {
