From b1906083e53d823951840aa18a931bef78bff014 Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Fri, 17 Jul 2026 17:00:14 -0700
Subject: [PATCH 40/71] video: rockchip: mpp: unlink sessions before private
 teardown

The mpp_service procfs readers walk srv->session_list while holding
session_lock, but session teardown used to free session->priv and
session->dma before taking that lock and unlinking the session. A
concurrent sessions-summary read can therefore pass the priv check, race
teardown, and dereference freed or NULL device-private state in
rkvenc_dump_session().

Move service-list removal into mpp_session_deinit(), before the device
deinit callback. Taking session_lock there also waits for an in-progress
procfs reader before private or DMA state is released. Remove the
now-redundant unlinking from the default and rkvdec2-link teardown paths,
and defensively ignore a NULL rkvenc private pointer.

Signed-off-by: rkvenc forward-port <forward-port@local>
---
 drivers/video/rockchip/mpp/mpp_common.c       | 22 ++++++++++++-------
 drivers/video/rockchip/mpp/mpp_rkvdec2_link.c |  7 ------
 drivers/video/rockchip/mpp/mpp_rkvenc2.c      |  3 +++
 3 files changed, 17 insertions(+), 15 deletions(-)

diff --git a/drivers/video/rockchip/mpp/mpp_common.c b/drivers/video/rockchip/mpp/mpp_common.c
index 6b460c88e09f5..e10d603119432 100644
--- a/drivers/video/rockchip/mpp/mpp_common.c
+++ b/drivers/video/rockchip/mpp/mpp_common.c
@@ -444,14 +444,6 @@ static void mpp_session_deinit_default(struct mpp_session *session)
 		}
 	}
 
-	if (session->srv) {
-		struct mpp_service *srv = session->srv;
-
-		mutex_lock(&srv->session_lock);
-		list_del_init(&session->service_link);
-		mutex_unlock(&srv->session_lock);
-	}
-
 	list_del_init(&session->session_link);
 }
 
@@ -460,6 +452,20 @@ void mpp_session_deinit(struct mpp_session *session)
 	mpp_dbg_session("session %d:%d task %d deinit\n", session->pid,
 			session->index, atomic_read(&session->task_count));
 
+	/*
+	 * Procfs walks the service list under session_lock and may inspect the
+	 * device-private and DMA state.  Remove the session from that list before
+	 * a device deinit callback can free either object.  Taking the mutex also
+	 * waits for an in-progress procfs reader to finish using the session.
+	 */
+	if (session->srv) {
+		struct mpp_service *srv = session->srv;
+
+		mutex_lock(&srv->session_lock);
+		list_del_init(&session->service_link);
+		mutex_unlock(&srv->session_lock);
+	}
+
 	if (likely(session->deinit))
 		session->deinit(session);
 	else
diff --git a/drivers/video/rockchip/mpp/mpp_rkvdec2_link.c b/drivers/video/rockchip/mpp/mpp_rkvdec2_link.c
index a4b818acc207d..8ff38b00255fc 100644
--- a/drivers/video/rockchip/mpp/mpp_rkvdec2_link.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvdec2_link.c
@@ -1571,13 +1571,6 @@ void rkvdec2_link_session_deinit(struct mpp_session *session)
 		mpp_iommu_up_write(mpp->iommu_info);
 		session->dma = NULL;
 	}
-	if (session->srv) {
-		struct mpp_service *srv = session->srv;
-
-		mutex_lock(&srv->session_lock);
-		list_del_init(&session->service_link);
-		mutex_unlock(&srv->session_lock);
-	}
 	list_del_init(&session->session_link);
 
 	mpp_dbg_session("session %d release\n", session->index);
diff --git a/drivers/video/rockchip/mpp/mpp_rkvenc2.c b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
index c9ea9607a930d..1bb7ef85a7e71 100644
--- a/drivers/video/rockchip/mpp/mpp_rkvenc2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
@@ -2056,6 +2056,9 @@ static int rkvenc_dump_session(struct mpp_session *session, struct seq_file *seq
 	int i;
 	struct rkvenc2_session_priv *priv = session->priv;
 
+	if (!priv)
+		return 0;
+
 	down_read(&priv->rw_sem);
 	/* item name */
 	seq_puts(seq, "------------------------------------------------------");
