From 53360159f99c847f821f4637e18d221676c9ed8c Mon Sep 17 00:00:00 2001
From: rkvenc forward-port <forward-port@local>
Date: Sun, 22 Nov 2026 07:03:20 -0800
Subject: [PATCH 101/107] video: rockchip: mpp: suppress sysfs unbind for
 rkvdec2, rkvenc2 and av1dec

Unbinding a codec through sysfs runs its remove callback while sessions
can still reference the device: srv->sub_devices[] keeps the pointer,
session->mpp is not invalidated, the queue is not drained, and the
device structure is devm-freed. A later ioctl on an open or new session
then uses freed memory. Root can trigger this; no unprivileged path can.

IEP2 and the service driver already set suppress_bind_attrs for the same
reason. Do the same for the remaining sub-drivers.

Assisted-by: Claude:claude-opus-5-5
---
 drivers/video/rockchip/mpp/mpp_av1dec.c  | 2 ++
 drivers/video/rockchip/mpp/mpp_rkvdec2.c | 2 ++
 drivers/video/rockchip/mpp/mpp_rkvenc2.c | 2 ++
 3 files changed, 6 insertions(+)

diff --git a/drivers/video/rockchip/mpp/mpp_av1dec.c b/drivers/video/rockchip/mpp/mpp_av1dec.c
index 39c63f49a0f3..162634e4ed7f 100644
--- a/drivers/video/rockchip/mpp/mpp_av1dec.c
+++ b/drivers/video/rockchip/mpp/mpp_av1dec.c
@@ -1184,5 +1184,7 @@ struct platform_driver rockchip_av1dec_driver = {
 	.driver = {
 		.name = AV1DEC_DRIVER_NAME,
 		.of_match_table = of_match_ptr(mpp_av1dec_dt_match),
+		/* Common MPP lacks a safe per-subdevice hot-unbind contract. */
+		.suppress_bind_attrs = true,
 	},
 };
diff --git a/drivers/video/rockchip/mpp/mpp_rkvdec2.c b/drivers/video/rockchip/mpp/mpp_rkvdec2.c
index 564e0c8776d1..ce2c66ad4ac8 100644
--- a/drivers/video/rockchip/mpp/mpp_rkvdec2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvdec2.c
@@ -2332,6 +2332,8 @@ struct platform_driver rockchip_rkvdec2_driver = {
 		.name = RKVDEC_DRIVER_NAME,
 		.of_match_table = of_match_ptr(mpp_rkvdec2_dt_match),
 		.pm = &rkvdec2_pm_ops,
+		/* Common MPP lacks a safe per-subdevice hot-unbind contract. */
+		.suppress_bind_attrs = true,
 	},
 };
 EXPORT_SYMBOL(rockchip_rkvdec2_driver);
diff --git a/drivers/video/rockchip/mpp/mpp_rkvenc2.c b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
index fa125b7cb19a..bf22a6823163 100644
--- a/drivers/video/rockchip/mpp/mpp_rkvenc2.c
+++ b/drivers/video/rockchip/mpp/mpp_rkvenc2.c
@@ -3775,5 +3775,7 @@ struct platform_driver rockchip_rkvenc2_driver = {
 		.name = RKVENC_DRIVER_NAME,
 		.of_match_table = of_match_ptr(mpp_rkvenc_dt_match),
 		.pm = &mpp_common_pm_ops,
+		/* Common MPP lacks a safe per-subdevice hot-unbind contract. */
+		.suppress_bind_attrs = true,
 	},
 };
