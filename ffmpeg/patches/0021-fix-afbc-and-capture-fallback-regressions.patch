+        tried_single_planar = 1;
+        select_capture_type(s, 0);
+        goto retry_setup;
+    }
+    goto fail;
+
 fail:
     v4l2_close(s->fd);
     return res;
diff --git a/libavfilter/rkrga_common.c b/libavfilter/rkrga_common.c
