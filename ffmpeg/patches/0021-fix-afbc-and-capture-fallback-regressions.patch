                                                  s->width, s->height, 1);
     if ((res = validate_multiplanar_raw_layout(ctx, st->codecpar->format)) < 0)
+        goto retry_or_fail;
+
+    /* If no pixel_format was specified, the codec_id was not known up
+     * until now. Set video_codec_id in the context, as codec_id will
