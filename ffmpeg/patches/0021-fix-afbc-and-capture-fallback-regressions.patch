+    if ((res = v4l2_set_parameters(ctx)) < 0)
         goto fail;
 
     if ((res = mmap_init(ctx)) ||
@@ -1290,6 +1328,16 @@ static int v4l2_read_header(AVFormatContext *ctx)
 
     return 0;
 
+retry_or_fail:
+    if (s->multiplanar && s->has_capture && !tried_single_planar) {
