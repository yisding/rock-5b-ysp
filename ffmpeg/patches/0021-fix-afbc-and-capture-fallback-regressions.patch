     /* P010 requires RGA3 */
     if (!r->has_rga3 &&
@@ -1989,8 +2066,6 @@ av_cold int ff_rkrga_init(AVFilterContext *avctx, RKRGAParam *param)
     if (avctx->nb_inputs > 1) {
