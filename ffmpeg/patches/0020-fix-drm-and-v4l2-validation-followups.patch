-        *stride = reverse ? (*stride / 3) : (*stride * 3);
-    else
+    scaled_stride = *stride;
+    if (desc->log2_chroma_w == 1 && desc->log2_chroma_h == 1) {
+        if (reverse) {
+            scaled_stride *= 2;
+            divisor = 3;
+        } else {
+            scaled_stride *= 3;
+            divisor = 2;
