+static int v4l2_single_buffer_plane_linesize(enum AVPixelFormat pix_fmt,
+                                             const AVPixFmtDescriptor *desc,
+                                             int base_linesize, int plane,
+                                             int *linesize)
+{
+    if (plane > 0) {
