@@ -1393,11 +1457,13 @@ int ff_rkrga_filter_frame(RKRGAContext *r,
             if (!(pat_in = submit_frame(r, inlink_pat, picref_pat, 0, 1))) {
                 av_log(ctx, AV_LOG_ERROR, "Failed to submit frame on input: %d\n",
