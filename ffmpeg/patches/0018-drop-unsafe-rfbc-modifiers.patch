+        int min_linesize = av_image_get_linesize(pix_fmt, width, 0);
+
+        if (min_linesize < 0)
+            return min_linesize;
+        if (plane0->pitch < min_linesize)
+            return AVERROR(EINVAL);
+        switch (pix_fmt) {
+        case AV_PIX_FMT_GRAY8:
+            *ws = plane0->pitch;
+            break;
+        case AV_PIX_FMT_RGB555LE:
+        case AV_PIX_FMT_BGR555LE:
