+    if (!object || !layer || !ws || !hs || width <= 0 || height <= 0)
         return AVERROR(EINVAL);
 
     plane0 = &layer->planes[0];
@@ -141,7 +143,39 @@ static int get_pixel_stride(const AVDRMObjectDescriptor *object,
