+/*
+ * Readback via a GL_PIXEL_PACK_BUFFER. Binding a real PBO at glReadPixels time
+ * is what flips Mesa from the blocking _mesa_readpixels (CPU detile/staging)
+ * onto the try_pbo_readpixels GPU pack fast path. The map+memcpy completes in
+ * this same call, after waiting on a GLsync fence, so the consumer always sees
+ * a fully populated dst_data when the callback fires.
+ */
+static gboolean
+read_pixels_pbo_in_impl (GrdEglThread          *egl_thread,
+                         GrdDownloadCacheEntry *entry,
+                         GrdEglTaskDownload    *task)
+{
+  size_t size = (size_t) task->dst_row_width * task->height * 4;
+  unsigned int i = entry->ring_head;
+  gboolean debug = egl_thread->impl.readback_debug;
+  GLenum wait_result;
+  GLenum error;
+  void *mapped;
+  int64_t t0 = 0, t1 = 0, t2 = 0, t3 = 0, t4 = 0, t5 = 0;
+
+  if (entry->pbo[i] == 0 || entry->pbo_size[i] != size)
+    {
+      if (entry->pbo[i] == 0)
+        glGenBuffers (1, &entry->pbo[i]);
+      glBindBuffer (GL_PIXEL_PACK_BUFFER, entry->pbo[i]);
+      glBufferData (GL_PIXEL_PACK_BUFFER, size, NULL, GL_STREAM_READ);
+      entry->pbo_size[i] = size;
+    }
+
+  glBindFramebuffer (GL_FRAMEBUFFER, entry->fbo);
+  glPixelStorei (GL_PACK_ROW_LENGTH, task->dst_row_width);
+  glBindBuffer (GL_PIXEL_PACK_BUFFER, entry->pbo[i]);
+
+  if (debug)
+    t0 = g_get_monotonic_time ();
+
+  glReadPixels (0, 0, task->width, task->height,
+                GL_BGRA, GL_UNSIGNED_BYTE, (void *) 0);
+
+  if (debug)
+    t1 = g_get_monotonic_time ();
+
+  if (entry->fence[i])
+    glDeleteSync (entry->fence[i]);
+  entry->fence[i] = glFenceSync (GL_SYNC_GPU_COMMANDS_COMPLETE, 0);
+  glFlush ();
+
+  if (debug)
+    t2 = g_get_monotonic_time ();
+
+  do
+    {
+      wait_result = glClientWaitSync (entry->fence[i],
+                                      GL_SYNC_FLUSH_COMMANDS_BIT,
+                                      1000000000ULL);
+    }
+  while (wait_result == GL_TIMEOUT_EXPIRED);
+
+  if (debug)
+    t3 = g_get_monotonic_time ();
+
+  mapped = glMapBufferRange (GL_PIXEL_PACK_BUFFER, 0, size, GL_MAP_READ_BIT);
+
+  if (debug)
+    t4 = g_get_monotonic_time ();
+
+  if (!mapped)
+    {
+      g_warning ("[EGL Thread] Failed to map PBO for readback");
+      glBindBuffer (GL_PIXEL_PACK_BUFFER, 0);
+      glDeleteSync (entry->fence[i]);
+      entry->fence[i] = 0;
+      return FALSE;
+    }
+
+  memcpy (task->dst_data, mapped, size);
+
+  if (debug)
+    t5 = g_get_monotonic_time ();
+
+  glUnmapBuffer (GL_PIXEL_PACK_BUFFER);
+  glBindBuffer (GL_PIXEL_PACK_BUFFER, 0);
+  glDeleteSync (entry->fence[i]);
+  entry->fence[i] = 0;
+
+  entry->ring_head = (i + 1) % entry->ring_size;
+
+  error = glGetError ();
+  if (error != GL_NO_ERROR)
+    {
+      g_warning ("[EGL Thread] GL error during PBO readback: %u", error);
+      return FALSE;
+    }
+
+  if (debug)
+    {
+      g_message ("[EGL Thread] async readback %ux%u ring=%u: "
+                 "t_issue=%.3fms t_fence=%.3fms t_map=%.3fms t_copy=%.3fms",
+                 task->width, task->height, i,
+                 (t1 - t0) / 1000.0,
+                 (t3 - t2) / 1000.0,
+                 (t4 - t3) / 1000.0,
+                 (t5 - t4) / 1000.0);
+    }
+
+  return TRUE;
+}
