+/*
+ * The EGL thread download cache keys cached EGLImages/textures/FBOs on the raw
+ * dmabuf fd. The fd is owned by PipeWire and gets recycled to a new (unrelated)
+ * dmabuf once the buffer it belonged to is destroyed, so the cache MUST be told
+ * to drop the entry before that happens, otherwise a recycled fd with identical
+ * geometry would hit the stale entry and read back the wrong buffer's pixels.
+ */
+static void
+invalidate_egl_download_cache (GrdRdpPipeWireStream *stream,
+                               GrdRdpPwBuffer       *rdp_pw_buffer)
+{
+  GrdSession *session = GRD_SESSION (stream->session_rdp);
+  GrdContext *context = grd_session_get_context (session);
+  GrdEglThread *egl_thread = grd_context_get_egl_thread (context);
+  const GrdRdpPwBufferDmaBufInfo *dma_buf_info;
+
+  if (!egl_thread)
+    return;
+
+  dma_buf_info = grd_rdp_pw_buffer_get_dma_buf_info (rdp_pw_buffer);
+  if (!dma_buf_info)
+    return;
+
+  grd_egl_thread_invalidate_buffer (egl_thread, dma_buf_info->fd);
+}
+
+static void
+invalidate_egl_download_cache_foreach (gpointer key,
+                                       gpointer value,
+                                       gpointer user_data)
+{
+  invalidate_egl_download_cache (user_data, value);
+}
