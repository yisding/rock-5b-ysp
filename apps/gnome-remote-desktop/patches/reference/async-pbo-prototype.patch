+/*
+ * Like bind_egl_image(), but without the per-create glPixelStorei
+ * (GL_PACK_ROW_LENGTH) call: pack row length is global pack state that must be
+ * set per-read (in read_pixels_pbo_in_impl), not at import time.
+ */
+static gboolean
+bind_egl_image_cached_in_impl (GrdEglThread *egl_thread,
+                               EGLImageKHR   egl_image,
+                               GLuint       *tex,
+                               GLuint       *fbo)
+{
+  GLenum error;
+
+  glGenTextures (1, tex);
+  glTexParameteri (GL_TEXTURE_2D, GL_TEXTURE_MAX_LEVEL, 0);
+  glTexParameteri (GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+  glBindTexture (GL_TEXTURE_2D, *tex);
+  glEGLImageTargetTexture2DOES (GL_TEXTURE_2D, egl_image);
+  error = glGetError ();
+  if (error != GL_NO_ERROR)
+    {
+      g_warning ("[EGL Thread] Failed to bind DMA buf texture: %u", error);
+      return FALSE;
+    }
+
+  glGenFramebuffers (1, fbo);
+  glBindFramebuffer (GL_FRAMEBUFFER, *fbo);
+  glFramebufferTexture2D (GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0,
+                          GL_TEXTURE_2D, *tex, 0);
+  if (glCheckFramebufferStatus (GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+    {
+      g_warning ("Failed to bind DMA buf framebuffer");
+      return FALSE;
+    }
+
+  return TRUE;
+}
+
+static void
+download_cache_entry_free_in_impl (gpointer data)
+{
+  GrdDownloadCacheEntry *entry = data;
+  GrdEglThread *egl_thread = entry->egl_thread;
+  unsigned int i;
+
+  for (i = 0; i < entry->ring_size; i++)
+    {
+      if (entry->fence[i])
+        glDeleteSync (entry->fence[i]);
+      if (entry->pbo[i])
+        glDeleteBuffers (1, &entry->pbo[i]);
+    }
+
+  if (entry->fbo)
+    glDeleteFramebuffers (1, &entry->fbo);
+  if (entry->tex)
+    glDeleteTextures (1, &entry->tex);
+  if (entry->egl_image != EGL_NO_IMAGE)
+    eglDestroyImageKHR (egl_thread->impl.egl_display, entry->egl_image);
+
+  g_free (entry);
+}
+
+static GrdDownloadCacheEntry *
+download_cache_entry_get_or_create_in_impl (GrdEglThread       *egl_thread,
+                                            GrdEglTaskDownload *task)
+{
+  GHashTable *cache = egl_thread->impl.download_cache;
+  gboolean have_modifier = task->modifiers != NULL;
+  uint64_t modifier = have_modifier ? task->modifiers[0] : 0;
+  int fd = task->fds[0];
+  GrdDownloadCacheEntry *entry;
+  EGLImageKHR egl_image;
+  GLuint tex = 0;
+  GLuint fbo = 0;
+
+  entry = g_hash_table_lookup (cache, GINT_TO_POINTER (fd));
+  if (entry)
+    {
+      if (entry->width == task->width &&
+          entry->height == task->height &&
+          entry->format == task->format &&
+          entry->stride == task->strides[0] &&
+          entry->offset == task->offsets[0] &&
+          entry->have_modifier == have_modifier &&
+          entry->modifier == modifier)
+        return entry;
+
+      /* fd was recycled to a different buffer: drop and rebuild. */
+      g_hash_table_remove (cache, GINT_TO_POINTER (fd));
+      entry = NULL;
+    }
+
+  egl_image = create_dmabuf_image (egl_thread,
+                                   task->width,
+                                   task->height,
+                                   task->format,
+                                   task->n_planes,
+                                   task->fds,
+                                   task->strides,
+                                   task->offsets,
+                                   task->modifiers);
+  if (egl_image == EGL_NO_IMAGE)
+    return NULL;
+
+  if (!bind_egl_image_cached_in_impl (egl_thread, egl_image, &tex, &fbo))
+    {
+      if (fbo)
+        glDeleteFramebuffers (1, &fbo);
+      if (tex)
+        glDeleteTextures (1, &tex);
+      eglDestroyImageKHR (egl_thread->impl.egl_display, egl_image);
+      return NULL;
+    }
+
+  /* Keep cache growth bounded; evict an arbitrary entry if at capacity. */
+  if (g_hash_table_size (cache) >= GRD_DOWNLOAD_CACHE_MAX_ENTRIES)
+    {
+      GHashTableIter iter;
+
+      g_hash_table_iter_init (&iter, cache);
+      if (g_hash_table_iter_next (&iter, NULL, NULL))
+        g_hash_table_iter_remove (&iter);
+    }
+
+  entry = g_new0 (GrdDownloadCacheEntry, 1);
+  entry->egl_thread = egl_thread;
+  entry->fd = fd;
+  entry->width = task->width;
+  entry->height = task->height;
+  entry->format = task->format;
+  entry->stride = task->strides[0];
+  entry->offset = task->offsets[0];
+  entry->have_modifier = have_modifier;
+  entry->modifier = modifier;
+  entry->egl_image = egl_image;
+  entry->tex = tex;
+  entry->fbo = fbo;
+  entry->ring_size = egl_thread->impl.readback_ring_size;
+  entry->ring_head = 0;
+
+  g_hash_table_insert (cache, GINT_TO_POINTER (fd), entry);
+
+  return entry;
+}
