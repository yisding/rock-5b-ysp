@@ -734,7 +947,13 @@ grd_rdp_renderer_try_acquire_render_context (GrdRdpRenderer            *renderer
   if (flags & GRD_RDP_ACQUIRE_CONTEXT_FLAG_FORCE_RESET)
     {
       if (!can_destroy_render_context_locked (renderer, rdp_surface))
-        return NULL;
