   if (renderer->surface_disposal_source)
     {
       g_source_destroy (renderer->surface_disposal_source);
@@ -945,6 +1169,7 @@ grd_rdp_renderer_finalize (GObject *object)
   g_mutex_clear (&renderer->frame_encodings_mutex);
   g_mutex_clear (&renderer->view_creations_mutex);
   g_mutex_clear (&renderer->hw_encode_mutex);
+  g_mutex_clear (&renderer->pipeline_diagnostics_mutex);
 
   g_cond_clear (&renderer->stop_rendering_cond);
   g_mutex_clear (&renderer->inhibition_mutex);
@@ -1027,6 +1252,10 @@ on_bitstream_locked (GrdEncodeSession *encode_session,
     grd_rdp_frame_get_render_context (rdp_frame);
   GrdRdpCodec codec = grd_rdp_render_context_get_codec (render_context);
 
+  grd_rdp_renderer_notify_pipeline_event (
+    renderer, GRD_RDP_PIPELINE_EVENT_ENCODE_COMPLETED,
+    grd_rdp_frame_get_source_serial (rdp_frame), lock_duration_us);
+
   switch (codec)
     {
     case GRD_RDP_CODEC_CAPROGRESSIVE:
@@ -1079,6 +1308,10 @@ encode_image_views (GrdRdpRenderer *renderer,
       GrdEncodeContext *encode_context =
         grd_rdp_frame_get_encode_context (rdp_frame);
 
+      grd_rdp_renderer_notify_pipeline_event (
+        renderer, GRD_RDP_PIPELINE_EVENT_ENCODE_STARTED,
+        grd_rdp_frame_get_source_serial (rdp_frame), 0);
+
       if (!grd_encode_session_encode_frame (encode_session, encode_context,
                                             image_view, &error))
         {
@@ -1124,6 +1357,7 @@ maybe_start_encodings (GrdRdpRenderer *renderer)
       GrdRdpSurfaceRenderer *surface_renderer;
       GrdRdpViewCreator *view_creator;
       GrdEncodeSession *encode_session;
+      uint64_t latest_source_serial;
 
       g_assert (grd_rdp_frame_has_valid_view (rdp_frame));
 
@@ -1132,8 +1366,13 @@ maybe_start_encodings (GrdRdpRenderer *renderer)
       view_creator = grd_rdp_render_context_get_view_creator (render_context);
 
       if (grd_rdp_surface_renderer_is_frame_stale (surface_renderer,
-                                                   rdp_frame))
+                                                   rdp_frame,
+                                                   &latest_source_serial))
         {
+          grd_rdp_renderer_notify_pipeline_event (
+            renderer, GRD_RDP_PIPELINE_EVENT_STALE_FRAME_DROPPED,
+            grd_rdp_frame_get_source_serial (rdp_frame),
+            latest_source_serial);
           release_acquired_resource (renderer, render_context, view_creator);
           grd_rdp_surface_renderer_request_full_refresh (surface_renderer);
           g_hash_table_iter_remove (&iter);
@@ -1174,6 +1413,11 @@ on_view_created (GrdRdpFrame *rdp_frame,
 {
   GrdRdpRenderer *renderer = grd_rdp_frame_get_renderer (rdp_frame);
 
+  grd_rdp_renderer_notify_pipeline_event (
+    renderer, GRD_RDP_PIPELINE_EVENT_VIEW_COMPLETED,
+    grd_rdp_frame_get_source_serial (rdp_frame),
+    grd_rdp_frame_has_valid_view (rdp_frame));
+
   if (!grd_rdp_frame_has_valid_view (rdp_frame))
     g_warning ("[RDP] Failed to create image view: %s", error->message);
 
@@ -1224,6 +1468,10 @@ maybe_start_view_creations (GrdRdpRenderer *renderer)
       g_hash_table_insert (acquired_resources, view_creator, rdp_frame);
       g_hash_table_iter_steal (&iter);
 
+      grd_rdp_renderer_notify_pipeline_event (
+        renderer, GRD_RDP_PIPELINE_EVENT_VIEW_STARTED,
+        grd_rdp_frame_get_source_serial (rdp_frame), 0);
+
       if (!grd_rdp_view_creator_create_view (view_creator, rdp_frame,
                                              on_view_created, &error))
         {
@@ -1367,6 +1615,7 @@ grd_rdp_renderer_init (GrdRdpRenderer *renderer)
   GSource *surface_disposal_source;
   GSource *surface_render_source;
   GSource *hw_encode_cooldown_source;
+  GSource *pipeline_diagnostics_source;
 
   renderer->surface_renderer_table = g_hash_table_new (NULL, NULL);
   renderer->render_context_table = g_hash_table_new_full (NULL, NULL,
@@ -1395,6 +1644,8 @@ grd_rdp_renderer_init (GrdRdpRenderer *renderer)
   g_mutex_init (&renderer->view_creations_mutex);
   g_mutex_init (&renderer->frame_encodings_mutex);
   g_mutex_init (&renderer->hw_encode_mutex);
+  g_mutex_init (&renderer->pipeline_diagnostics_mutex);
+  renderer->pipeline_diagnostics.started_us = g_get_monotonic_time ();
 
   renderer->graphics_context = g_main_context_new ();
 
@@ -1418,6 +1669,13 @@ grd_rdp_renderer_init (GrdRdpRenderer *renderer)
   g_source_set_ready_time (hw_encode_cooldown_source, -1);
   g_source_attach (hw_encode_cooldown_source, renderer->graphics_context);
   renderer->hw_encode_cooldown_source = hw_encode_cooldown_source;
