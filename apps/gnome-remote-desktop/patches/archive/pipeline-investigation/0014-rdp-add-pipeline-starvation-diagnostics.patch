+void
+grd_rdp_renderer_notify_pipeline_event (GrdRdpRenderer      *renderer,
+                                        GrdRdpPipelineEvent  event,
+                                        uint64_t             source_serial,
+                                        int64_t              value)
+{
+  RdpPipelineDiagnostics *diagnostics = &renderer->pipeline_diagnostics;
+  int64_t now_us = g_get_monotonic_time ();
+
+  g_mutex_lock (&renderer->pipeline_diagnostics_mutex);
+  ++diagnostics->generation;
+
+  switch (event)
+    {
+    case GRD_RDP_PIPELINE_EVENT_BUFFER_RECEIVED:
+      ++diagnostics->buffers_received;
+      diagnostics->last_received_serial = source_serial;
+      diagnostics->last_buffer_us = now_us;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_FRAME_QUEUED:
+      ++diagnostics->frames_queued;
+      diagnostics->last_queued_serial = source_serial;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_VIEW_STARTED:
+      ++diagnostics->views_started;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_VIEW_COMPLETED:
+      ++diagnostics->views_completed;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_STALE_FRAME_DROPPED:
+      ++diagnostics->stale_frames_dropped;
+      diagnostics->last_stale_frame_serial = source_serial;
+      diagnostics->last_stale_latest_serial = value;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_ENCODE_STARTED:
+      ++diagnostics->encodes_started;
+      diagnostics->last_encode_serial = source_serial;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_ENCODE_COMPLETED:
+      ++diagnostics->encodes_completed;
+      diagnostics->last_encode_serial = source_serial;
+      diagnostics->last_encode_duration_us = value;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_FRAME_SUBMITTED:
+      ++diagnostics->frames_submitted;
+      diagnostics->last_submitted_serial = source_serial;
+      diagnostics->last_submit_us = now_us;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_FULL_REFRESH_REQUESTED:
+      ++diagnostics->full_refreshes_requested;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_FULL_REFRESH_DEFERRED:
+      ++diagnostics->full_refreshes_deferred;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_RENDER_CONTEXT_RESET_DEFERRED:
+      ++diagnostics->render_context_resets_deferred;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_HW_ENCODE_COOLDOWN_STARTED:
+      ++diagnostics->hw_encode_cooldowns_started;
+      break;
+    case GRD_RDP_PIPELINE_EVENT_HW_ENCODE_COOLDOWN_EXPIRED:
+      ++diagnostics->hw_encode_cooldowns_expired;
+      break;
+    }
+
+  g_mutex_unlock (&renderer->pipeline_diagnostics_mutex);
+}
+
+static gboolean
+log_pipeline_diagnostics (gpointer user_data)
+{
+  GrdRdpRenderer *renderer = user_data;
+  RdpPipelineDiagnostics diagnostics;
+  gboolean diagnostics_changed;
+  gboolean warn_about_starvation = FALSE;
+  int64_t now_us = g_get_monotonic_time ();
+  int64_t last_buffer_age_ms;
+  int64_t last_submit_age_ms;
+
+  g_mutex_lock (&renderer->pipeline_diagnostics_mutex);
+  diagnostics = renderer->pipeline_diagnostics;
+  diagnostics_changed =
+    diagnostics.generation != diagnostics.last_reported_generation;
+  if (diagnostics_changed)
+    renderer->pipeline_diagnostics.last_reported_generation =
+      diagnostics.generation;
+
+  if (diagnostics.last_buffer_us > 0 &&
+      now_us - diagnostics.last_buffer_us <
+        PIPELINE_STARVATION_THRESHOLD_US &&
+      now_us - MAX (diagnostics.last_submit_us,
+                    diagnostics.started_us) >=
+        PIPELINE_STARVATION_THRESHOLD_US &&
+      diagnostics.frames_queued > diagnostics.frames_submitted &&
+      now_us - diagnostics.last_starvation_warning_us >=
+        PIPELINE_STARVATION_WARNING_INTERVAL_US)
+    {
+      renderer->pipeline_diagnostics.last_starvation_warning_us = now_us;
+      warn_about_starvation = TRUE;
+    }
+  g_mutex_unlock (&renderer->pipeline_diagnostics_mutex);
+
+  last_buffer_age_ms = diagnostics.last_buffer_us > 0
+    ? (now_us - diagnostics.last_buffer_us) / 1000
+    : -1;
+  last_submit_age_ms = diagnostics.last_submit_us > 0
+    ? (now_us - diagnostics.last_submit_us) / 1000
+    : (now_us - diagnostics.started_us) / 1000;
+
+  if (diagnostics_changed)
+    {
+      g_message ("[RDP.PIPELINE] buffers=%" G_GUINT64_FORMAT
+                 "(serial=%" G_GUINT64_FORMAT ") queued=%" G_GUINT64_FORMAT
+                 "(serial=%" G_GUINT64_FORMAT ") views=%" G_GUINT64_FORMAT
+                 "/%" G_GUINT64_FORMAT " stale=%" G_GUINT64_FORMAT
+                 "(frame=%" G_GUINT64_FORMAT ",latest=%" G_GUINT64_FORMAT
+                 ") encodes=%" G_GUINT64_FORMAT "/%" G_GUINT64_FORMAT
+                 "(serial=%" G_GUINT64_FORMAT ",last-us=%" G_GINT64_FORMAT
+                 ") submitted=%" G_GUINT64_FORMAT
+                 "(serial=%" G_GUINT64_FORMAT ") refresh=%" G_GUINT64_FORMAT
+                 "/%" G_GUINT64_FORMAT " reset-waits=%" G_GUINT64_FORMAT
+                 " cooldown=%" G_GUINT64_FORMAT "/%" G_GUINT64_FORMAT
+                 " ages-ms(buffer=%" G_GINT64_FORMAT
+                 ",submit=%" G_GINT64_FORMAT ")",
+                 diagnostics.buffers_received,
+                 (guint64) diagnostics.last_received_serial,
+                 diagnostics.frames_queued,
+                 (guint64) diagnostics.last_queued_serial,
+                 diagnostics.views_started,
+                 diagnostics.views_completed,
+                 diagnostics.stale_frames_dropped,
+                 (guint64) diagnostics.last_stale_frame_serial,
+                 (guint64) diagnostics.last_stale_latest_serial,
+                 diagnostics.encodes_started,
+                 diagnostics.encodes_completed,
+                 (guint64) diagnostics.last_encode_serial,
+                 diagnostics.last_encode_duration_us,
+                 diagnostics.frames_submitted,
+                 (guint64) diagnostics.last_submitted_serial,
+                 diagnostics.full_refreshes_requested,
+                 diagnostics.full_refreshes_deferred,
+                 diagnostics.render_context_resets_deferred,
+                 diagnostics.hw_encode_cooldowns_started,
+                 diagnostics.hw_encode_cooldowns_expired,
+                 last_buffer_age_ms,
+                 last_submit_age_ms);
+    }
+
+  if (warn_about_starvation)
+    {
+      g_warning ("[RDP.PIPELINE] Suspected frame starvation: buffers are "
+                 "still arriving but no frame was submitted for %"
+                 G_GINT64_FORMAT " ms (queued=%" G_GUINT64_FORMAT
+                 ", stale=%" G_GUINT64_FORMAT ", views=%" G_GUINT64_FORMAT
+                 "/%" G_GUINT64_FORMAT ", encodes=%" G_GUINT64_FORMAT
+                 "/%" G_GUINT64_FORMAT ")",
+                 last_submit_age_ms,
+                 diagnostics.frames_queued,
+                 diagnostics.stale_frames_dropped,
+                 diagnostics.views_started,
+                 diagnostics.views_completed,
+                 diagnostics.encodes_started,
+                 diagnostics.encodes_completed);
+    }
+
+  return G_SOURCE_CONTINUE;
+}
+
 static void
 request_surface_full_refresh (gpointer key,
                               gpointer value,
@@ -204,6 +412,8 @@ recover_hw_encode_after_cooldown (gpointer user_data)
     }
 
