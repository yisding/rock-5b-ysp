         }
@@ -1391,8 +1435,6 @@ maybe_start_encodings (GrdRdpRenderer *renderer)
                                          NULL, (gpointer *) &acquired_resources))
         g_assert_not_reached ();
 
-      encode_session =
-        grd_rdp_render_context_get_encode_session (render_context);
       if (g_hash_table_contains (acquired_resources, encode_session))
         continue;
 
@@ -1648,6 +1690,7 @@ grd_rdp_renderer_init (GrdRdpRenderer *renderer)
   renderer->pipeline_diagnostics.started_us = g_get_monotonic_time ();
 
   renderer->graphics_context = g_main_context_new ();
+  renderer->pipeline_diagnostics_context = g_main_context_new ();
 
   surface_disposal_source = g_source_new (&source_funcs, sizeof (GSource));
   g_source_set_callback (surface_disposal_source, dispose_surfaces,
@@ -1674,8 +1717,12 @@ grd_rdp_renderer_init (GrdRdpRenderer *renderer)
     g_timeout_source_new (PIPELINE_DIAGNOSTICS_INTERVAL_MS);
   g_source_set_callback (pipeline_diagnostics_source,
                          log_pipeline_diagnostics, renderer, NULL);
-  g_source_attach (pipeline_diagnostics_source, renderer->graphics_context);
+  g_source_attach (pipeline_diagnostics_source,
+                   renderer->pipeline_diagnostics_context);
   renderer->pipeline_diagnostics_source = pipeline_diagnostics_source;
+  renderer->pipeline_diagnostics_thread =
+    g_thread_new ("RDP pipeline diagnostics",
+                  pipeline_diagnostics_thread_func, renderer);
 }
 
