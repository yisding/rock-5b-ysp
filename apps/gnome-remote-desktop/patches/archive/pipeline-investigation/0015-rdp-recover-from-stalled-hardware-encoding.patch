-      renderer->slow_hw_encode_window_start_us = 0;
-      renderer->slow_hw_encode_samples = 0;
-      started_cooldown = TRUE;
-    }
-
   g_mutex_unlock (&renderer->hw_encode_mutex);
 
-  if (!started_cooldown)
-    return;
+  if (reason)
+    start_hw_encode_cooldown (renderer, reason, duration_us);
+}
 
-  g_warning ("[RDP] Hardware encode is slow (%s, duration %" G_GINT64_FORMAT
-             " us); using software encoding for %" G_GINT64_FORMAT " us",
