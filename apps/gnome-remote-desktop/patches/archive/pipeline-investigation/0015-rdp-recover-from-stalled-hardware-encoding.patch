 src/grd-encode-session-vaapi.c  |  11 +++
 src/grd-encode-session.c        |   9 +++
 src/grd-encode-session.h        |   3 +
 src/grd-rdp-renderer.c          | 115 ++++++++++++++++++++++----------
 src/grd-rdp-surface-renderer.c  |  20 +++++-
 src/grd-rdp-surface-renderer.h  |   2 +
 7 files changed, 143 insertions(+), 66 deletions(-)

diff --git a/src/grd-encode-session-ffmpeg.c b/src/grd-encode-session-ffmpeg.c
index c4ed356..5016a4f 100644
--- a/src/grd-encode-session-ffmpeg.c
+++ b/src/grd-encode-session-ffmpeg.c
@@ -405,6 +405,14 @@ grd_encode_session_ffmpeg_has_pending_frames (GrdEncodeSession *encode_session)
   return g_hash_table_size (self->pending_frames) > 0;
 }
 
+static void
+grd_encode_session_ffmpeg_request_key_frame (GrdEncodeSession *encode_session)
+{
+  GrdEncodeSessionFfmpeg *self = GRD_ENCODE_SESSION_FFMPEG (encode_session);
+
+  self->force_next_idr = TRUE;
+}
+
 static gboolean
 grd_encode_session_ffmpeg_encode_frame (GrdEncodeSession  *encode_session,
                                         GrdEncodeContext  *encode_context,
@@ -557,9 +565,10 @@ create_encoder (GrdEncodeSessionFfmpeg  *self,
    * Load-bearing for ffmpeg-rockchip: without AV_CODEC_FLAG_LOW_DELAY its
    * encoder runs asynchronously (buffering several frames before the first
    * packet), which would break our strict 1-in-1-out lock_bitstream model and
-   * the startup smoke encode. With the flag it submits and blocks for each
-   * frame's packet. Mainline's encoder is 1-in-1-out regardless; the flag is
-   * harmless there.
+   * the startup smoke encode. The packaged Rockchip FFmpeg bounds this
+   * synchronous low-delay wait internally, so a lost MPP completion becomes a
+   * recoverable encode error instead of blocking GRD's encode or graphics
+   * thread forever.
    */
   self->avctx->flags |= AV_CODEC_FLAG_LOW_DELAY;
 
@@ -688,14 +697,6 @@ allocate_surfaces (GrdEncodeSessionFfmpeg  *self,
   return TRUE;
 }
 
-static void
-destroy_encoder (GrdEncodeSessionFfmpeg *self)
-{
-  av_buffer_unref (&self->hw_frames_ctx);
-  av_buffer_unref (&self->hw_device_ctx);
-  avcodec_free_context (&self->avctx);
-}
-
 static gboolean
 run_smoke_test (GrdEncodeSessionFfmpeg  *self,
                 NV12Surface             *surface,
@@ -723,25 +724,13 @@ run_smoke_test (GrdEncodeSessionFfmpeg  *self,
   av_packet_free (&packet);
 
   /*
-   * Make the first real frame a clean IDR (SPS + PPS + IDR slice). rkmpp only
-   * emits a full IDR access unit for the first frame after the encoder is opened,
-   * and the smoke encode above consumed this encoder's one natural IDR. The
-   * ffmpeg-rockchip fork honours per-frame forced IDR (frame->pict_type = I ->
-   * MPP_ENC_SET_IDR_FRAME), so force_next_idr below would recover it there - but
-   * mainline FFmpeg's h264_rkmpp ignores pict_type entirely (verified with
-   * -force_key_frames on 8.1.x), so on mainline every later frame is a bare
-   * P-slice with no parameter sets. Tearing the encoder down and reopening it
-   * makes the next frame a fresh natural IDR on any build. Without a leading IDR
-   * the client never decodes, never sends RDPGFX_FRAME_ACKNOWLEDGE, and the frame
-   * controller throttles the surface to zero slots after two unacknowledged
-   * frames - a permanent freeze. (avcodec_flush_buffers() hangs the rkmpp
-   * encoder; the surfaces are standalone dma-buf descriptors that outlive the
-   * encoder, so recreating hw_frames_ctx here is safe.)
+   * The smoke encode consumed the encoder's natural IDR. Both supported
+   * Rockchip FFmpeg variants honour a per-frame forced IDR through
+   * MPP_ENC_SET_IDR_FRAME, so request one for the first real frame. Reusing the
+   * validated context avoids a second open/close cycle and is important during
+   * rapid refreshes, where repeated MPP teardown/reinitialization can lose a
+   * completion.
    */
-  destroy_encoder (self);
-  if (!create_encoder (self, error))
-    return FALSE;
-
   self->force_next_idr = TRUE;
 
   return TRUE;
@@ -864,6 +853,8 @@ grd_encode_session_ffmpeg_class_init (GrdEncodeSessionFfmpegClass *klass)
     grd_encode_session_ffmpeg_get_image_views;
   encode_session_class->has_pending_frames =
     grd_encode_session_ffmpeg_has_pending_frames;
+  encode_session_class->request_key_frame =
+    grd_encode_session_ffmpeg_request_key_frame;
   encode_session_class->encode_frame =
     grd_encode_session_ffmpeg_encode_frame;
   encode_session_class->lock_bitstream =
