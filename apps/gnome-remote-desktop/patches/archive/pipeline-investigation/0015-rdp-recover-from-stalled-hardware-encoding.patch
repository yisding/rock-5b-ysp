                  G_GINT64_FORMAT " ms (queued=%" G_GUINT64_FORMAT
                  ", stale=%" G_GUINT64_FORMAT ", views=%" G_GUINT64_FORMAT
                  "/%" G_GUINT64_FORMAT ", encodes=%" G_GUINT64_FORMAT
@@ -428,14 +432,46 @@ schedule_hw_encode_cooldown_recovery (GrdRdpRenderer *renderer,
   g_main_context_wakeup (renderer->graphics_context);
 }
 
+static gboolean
+start_hw_encode_cooldown (GrdRdpRenderer *renderer,
+                          const char     *reason,
+                          int64_t         duration_us)
+{
+  int64_t now_us = g_get_monotonic_time ();
+  int64_t cooldown_until_us;
+
+  g_mutex_lock (&renderer->hw_encode_mutex);
+  if (now_us < renderer->hw_encode_cooldown_until_us)
+    {
+      g_mutex_unlock (&renderer->hw_encode_mutex);
+      return FALSE;
+    }
+
+  cooldown_until_us = now_us + HW_ENCODE_COOLDOWN_US;
+  renderer->hw_encode_cooldown_until_us = cooldown_until_us;
+  renderer->slow_hw_encode_window_start_us = 0;
+  renderer->slow_hw_encode_samples = 0;
+  g_mutex_unlock (&renderer->hw_encode_mutex);
+
+  g_warning ("[RDP] Hardware encode is unavailable (%s, duration %"
+             G_GINT64_FORMAT " us); using software encoding for %"
+             G_GINT64_FORMAT " us",
+             reason, (gint64) duration_us, (gint64) HW_ENCODE_COOLDOWN_US);
+  grd_rdp_renderer_notify_pipeline_event (
+    renderer, GRD_RDP_PIPELINE_EVENT_HW_ENCODE_COOLDOWN_STARTED, 0,
+    duration_us);
+  schedule_hw_encode_cooldown_recovery (renderer, cooldown_until_us);
+  request_full_refresh_for_all_surfaces (renderer);
+
+  return TRUE;
+}
