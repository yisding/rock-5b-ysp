       if (grd_rdp_surface_renderer_is_frame_stale (surface_renderer,
                                                    rdp_frame,
@@ -1373,8 +1416,9 @@ maybe_start_encodings (GrdRdpRenderer *renderer)
             renderer, GRD_RDP_PIPELINE_EVENT_STALE_FRAME_DROPPED,
             grd_rdp_frame_get_source_serial (rdp_frame),
             latest_source_serial);
+          grd_encode_session_request_key_frame (encode_session);
           release_acquired_resource (renderer, render_context, view_creator);
-          grd_rdp_surface_renderer_request_full_refresh (surface_renderer);
